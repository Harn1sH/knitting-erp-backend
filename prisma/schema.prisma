generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ChallanCounter {
  id         String @id @default(cuid())
  type       String
  year       Int
  lastNumber Int

  @@unique([type, year])
}

model DeliveryChallan {
  id          String         @id @default(uuid())
  dcNo        String         @unique
  jobCardId   String
  vehicle     String?
  companyName String?
  date        DateTime
  createdAt   DateTime       @default(now())
  jobCard     JobCard        @relation(fields: [jobCardId], references: [id])
  items       DeliveryItem[]
}

model DeliveryItem {
  id            String          @id @default(uuid())
  challanId     String
  fabricItemId  String?
  quantityKg    Float
  numberOfRolls Int?
  fabricName    String?
  fabricType    String?
  rolls         Int
  dia           String?
  challan       DeliveryChallan @relation(fields: [challanId], references: [id])
  fabricItem    FabricItem?     @relation(fields: [fabricItemId], references: [id])
}

model YarnInwardChallan {
  id            String           @id @default(uuid())
  grnNo         String           @unique
  jobCardId     String
  supplierId    String
  entryDate     DateTime
  remarks       String?
  createdAt     DateTime         @default(now())
  partyDcNumber String?
  vehicleNumber String?
  jobCard       JobCard          @relation(fields: [jobCardId], references: [id])
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  items         YarnInwardItem[]
}

model YarnInwardItem {
  id               String            @id @default(uuid())
  challanId        String
  fabricItemId     String?
  yarnName         String
  color            String?
  bags             Int
  netWeight        Float
  weightPerBag     Float
  supplierId       String?
  customFabricItem String?
  dia              String?
  challan          YarnInwardChallan @relation(fields: [challanId], references: [id])
  fabricItem       FabricItem?       @relation(fields: [fabricItemId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
}

model JobCard {
  id                 String              @id @default(uuid())
  jobNumber          String              @unique
  customerName       String
  status             String
  createdAt          DateTime            @default(now())
  remarks            String
  brand              String
  machine            String
  machineNote        String
  jobReceivedDate    DateTime            @default(now())
  deliveryChallans   DeliveryChallan[]
  fabricItems        FabricItem[]
  productions        Production[]
  yarnInwardChallans YarnInwardChallan[]
  yarnReturns        YarnReturn[]

  @@index([createdAt(sort: Desc)])
}

model Production {
  id         String   @id @default(uuid())
  jobCardId  String
  operatorId String?
  machine    String
  kgProduced Float
  hoursRun   Float
  stoppage   String?
  date       DateTime
  jobCard    JobCard  @relation(fields: [jobCardId], references: [id])
  operator   User?    @relation(fields: [operatorId], references: [id])
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  role        Role
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  productions Production[]
}

model JobCardCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model Supplier {
  id                 String              @id @default(cuid())
  name               String
  contactPerson      String?
  email              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  gstNumber          String?             @unique
  panNumber          String?
  paymentTerms       String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accountNumber      String?
  altPhoneNumber     String?
  bankName           String?
  ifscCode           String?
  phoneNumber        String?
  remarks            String?
  yarnInwardChallans YarnInwardChallan[]
  yarnInwardItems    YarnInwardItem[]
  yarnReturns        YarnReturn[]
}

model Client {
  id             String   @id @default(cuid())
  name           String
  contactPerson  String?
  phoneNumber    String?
  altPhoneNumber String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  gstNumber      String?  @unique
  panNumber      String?
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  remarks        String?
  paymentTerms   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MasterEntry {
  id          String   @id @default(cuid())
  category    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, name])
}

model FabricItem {
  id              String           @id @default(cuid())
  jobCardId       String
  gsm             String
  dia             String?
  count           String
  composition     String
  quality         String
  mill            String
  rate            Float
  orderQuantity   Float
  createdAt       DateTime         @default(now())
  gg              Float            @default(0)
  ll              Float            @default(0)
  deliveryItems   DeliveryItem[]
  jobCard         JobCard          @relation(fields: [jobCardId], references: [id])
  yarnInwardItems YarnInwardItem[]
  yarnReturnItems YarnReturnItem[]
}

model Employee {
  id            String          @id
  name          String
  phone         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  ProductionLog ProductionLog[]
}

model ProductionLog {
  id             String   @id
  employeeId     String
  fabricType     String
  dia            String
  rollsCompleted Int
  weight         Float
  date           DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  Employee       Employee @relation(fields: [employeeId], references: [id])
}

enum Role {
  ADMIN
  EMPLOYEE
}

model YarnReturn {
  id            String           @id @default(uuid())
  dcNumber      String           @unique
  jobCardId     String
  supplierId    String
  date          DateTime
  vehicleNumber String?
  remarks       String?
  createdAt     DateTime         @default(now())
  jobCard       JobCard          @relation(fields: [jobCardId], references: [id])
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  items         YarnReturnItem[]
}

model YarnReturnItem {
  id           String      @id @default(uuid())
  yarnReturnId String
  fabricItemId String?
  yarnName     String
  bags         Int
  netWeight    Float
  weightPerBag Float
  yarnReturn   YarnReturn  @relation(fields: [yarnReturnId], references: [id])
  fabricItem   FabricItem? @relation(fields: [fabricItemId], references: [id])
}
