generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "fullTextSearch"]
}

datasource db {
  provider = "postgresql"
}

model ChallanCounter {
  id         String @id @default(cuid())
  type       String
  year       Int
  lastNumber Int

  @@unique([type, year])
}

model DeliveryChallan {
  id          String         @id @default(uuid())
  dcNo        String         @unique
  jobCardId   String
  vehicle     String?
  companyName String?
  date        DateTime
  createdAt   DateTime       @default(now())
  invoiceId   String?
  partyDcNo   String?
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id])
  jobCard     JobCard        @relation(fields: [jobCardId], references: [id])
  items       DeliveryItem[]

  @@index([jobCardId])
  @@index([invoiceId])
  @@index([date])
}

model DeliveryItem {
  id            String          @id @default(uuid())
  challanId     String
  fabricItemId  String?
  quantityKg    Float
  numberOfRolls Int?
  fabricName    String?
  rolls         Int
  dia           String?
  fabricType    String?
  gg            Float?
  ll            Float?
  challan       DeliveryChallan @relation(fields: [challanId], references: [id])
  fabricItem    FabricItem?     @relation(fields: [fabricItemId], references: [id])

  @@index([challanId])
  @@index([fabricItemId])
}

model YarnInwardChallan {
  id            String           @id @default(uuid())
  grnNo         String           @unique
  jobCardId     String
  supplierId    String
  entryDate     DateTime
  remarks       String?
  createdAt     DateTime         @default(now())
  partyDcNumber String?
  vehicleNumber String?
  jobCard       JobCard          @relation(fields: [jobCardId], references: [id])
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  items         YarnInwardItem[]
  stockTransfers YarnStockLedger[]

  @@index([jobCardId])
  @@index([supplierId])
  @@index([entryDate])
}

model YarnInwardItem {
  id               String            @id @default(uuid())
  challanId        String
  fabricItemId     String?
  yarnName         String
  color            String?
  bags             Int
  netWeight        Float
  weightPerBag     Float
  supplierId       String?
  customFabricItem String?
  dia              String?
  challan          YarnInwardChallan @relation(fields: [challanId], references: [id])
  fabricItem       FabricItem?       @relation(fields: [fabricItemId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])

  @@index([challanId])
  @@index([fabricItemId])
  @@index([supplierId])
}

model JobCard {
  id                 String              @id @default(uuid())
  jobNumber          String              @unique
  customerName       String
  status             String
  createdAt          DateTime            @default(now())
  remarks            String
  brand              String
  machine            String
  machineNote        String
  jobReceivedDate    DateTime            @default(now())
  invoiceDate        DateTime?
  invoiceNumber      String?
  invoiceRates       Json?
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id])
  deliveryChallans   DeliveryChallan[]
  fabricItems        FabricItem[]
  invoices           Invoice[]
  productions        Production[]
  productionLogs     ProductionLog[]
  yarnInwardChallans YarnInwardChallan[]
  yarnReturns        YarnReturn[]
  stockTransfersIn   YarnStockLedger[]   @relation("StockTransferSource")
  stockTransfersOut  YarnStockLedger[]   @relation("StockTransferTarget")

  @@index([createdAt(sort: Desc)])
  @@index([clientId])
}

model Production {
  id         String   @id @default(uuid())
  jobCardId  String
  operatorId String?
  machine    String
  kgProduced Float
  hoursRun   Float
  stoppage   String?
  date       DateTime
  jobCard    JobCard  @relation(fields: [jobCardId], references: [id])
  operator   User?    @relation(fields: [operatorId], references: [id])

  @@index([jobCardId])
  @@index([operatorId])
  @@index([date])
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  role        Role
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  productions Production[]
}

model JobCardCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model InvoiceCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model Supplier {
  id                 String              @id @default(cuid())
  name               String
  contactPerson      String?
  email              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  gstNumber          String?             @unique
  panNumber          String?
  paymentTerms       String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accountNumber      String?
  altPhoneNumber     String?
  bankName           String?
  ifscCode           String?
  phoneNumber        String?
  remarks            String?
  yarnInwardChallans YarnInwardChallan[]
  yarnInwardItems    YarnInwardItem[]
  yarnReturns        YarnReturn[]
}

model Client {
  id             String   @id @default(cuid())
  name           String
  contactPerson  String?
  phoneNumber    String?
  altPhoneNumber String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  gstNumber      String?  @unique
  panNumber      String?
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  remarks        String?
  paymentTerms   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobCards       JobCard[]
  stockLedgers   YarnStockLedger[]

  @@index([name])
  @@index([isActive])
}

model MasterEntry {
  id          String   @id @default(cuid())
  category    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, name])
  @@index([category])
  @@index([name])
}

model FabricItem {
  id              String           @id @default(cuid())
  jobCardId       String
  gsm             String
  count           String
  composition     String
  quality         String
  mill            String
  rate            Float
  orderQuantity   Float
  createdAt       DateTime         @default(now())
  gg              Float            @default(0)
  ll              Float            @default(0)
  deliveryItems   DeliveryItem[]
  jobCard         JobCard          @relation(fields: [jobCardId], references: [id])
  yarnInwardItems YarnInwardItem[]
  yarnReturnItems YarnReturnItem[]

  @@index([jobCardId])
}

model Employee {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productionLogs ProductionLog[]
}

model ProductionLog {
  id             String   @id @default(cuid())
  jobCardId      String?
  employeeId     String
  fabricType     String
  dia            String
  rollsCompleted Int
  weight         Float
  date           DateTime
  shift          Shift    @default(DAY)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id])
  jobCard        JobCard? @relation(fields: [jobCardId], references: [id])

  @@index([employeeId])
  @@index([jobCardId])
  @@index([date])
  @@index([shift])
}

model YarnReturn {
  id            String           @id @default(uuid())
  dcNumber      String           @unique
  jobCardId     String
  supplierId    String
  date          DateTime
  vehicleNumber String?
  partyDcNumber String?
  remarks       String?
  createdAt     DateTime         @default(now())
  jobCard       JobCard          @relation(fields: [jobCardId], references: [id])
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  items         YarnReturnItem[]

  @@index([jobCardId])
  @@index([supplierId])
  @@index([date])
}

model YarnReturnItem {
  id           String      @id @default(uuid())
  yarnReturnId String
  fabricItemId String?
  yarnName     String
  bags         Int
  netWeight    Float
  weightPerBag Float
  fabricItem   FabricItem? @relation(fields: [fabricItemId], references: [id])
  yarnReturn   YarnReturn  @relation(fields: [yarnReturnId], references: [id])

  @@index([yarnReturnId])
  @@index([fabricItemId])
}

model Invoice {
  id               String            @id @default(uuid())
  invoiceNumber    String            @unique
  jobCardId        String
  date             DateTime          @default(now())
  rates            Json
  deliveryChallans DeliveryChallan[]
  jobCard          JobCard           @relation(fields: [jobCardId], references: [id])

  @@index([jobCardId])
  @@index([date])
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum Shift {
  DAY
  NIGHT
}

enum StockTransferType {
  IN
  OUT
}

model YarnStockLedger {
  id              String            @id @default(uuid())
  type            StockTransferType
  clientId        String
  sourceJobCardId String?
  targetJobCardId String?
  linkedChallanId String?
  yarnName        String
  bags            Int
  netWeight       Float
  date            DateTime          @default(now())
  remarks         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  client          Client            @relation(fields: [clientId], references: [id])
  sourceJobCard   JobCard?          @relation("StockTransferSource", fields: [sourceJobCardId], references: [id])
  targetJobCard   JobCard?          @relation("StockTransferTarget", fields: [targetJobCardId], references: [id])
  linkedChallan   YarnInwardChallan? @relation(fields: [linkedChallanId], references: [id])

  @@index([clientId])
  @@index([sourceJobCardId])
  @@index([targetJobCardId])
  @@index([linkedChallanId])
  @@index([date])
}

